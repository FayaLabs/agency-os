# Leave these EMPTY to run Agency OS in mock mode (in-memory + localStorage).
# Set them to point at a Supabase project to switch auth/org/providers to live data.
VITE_SUPABASE_URL=
# New-style Supabase publishable key (sb_publishable_...). The legacy
# VITE_SUPABASE_ANON_KEY is still read as a fallback for older projects.
VITE_SUPABASE_PUBLISHABLE_KEY=
